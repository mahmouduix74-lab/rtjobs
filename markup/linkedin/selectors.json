{
  "login": {
    "username": "input[autocomplete*='username']:visible",
    "password": "input[autocomplete='current-password']:visible",
    "credential_error": "#error-for-password, #error-for-username",
    "error": ".alert-content, #error",
    "sign_in_with_email": "Sign in with email",
    "continue": "Continue"
  },
  "api": {
    "cards_url": "https://www.linkedin.com/voyager/api/voyagerJobsDashJobCards?decorationId=com.linkedin.voyager.dash.deco.jobs.search.JobSearchCardsCollection-221&count={count}&q=jobSearch&query=(origin:JOB_SEARCH_PAGE_JOB_FILTER,locationUnion:(geoId:{geo_id}),selectedFilters:(sortBy:List(DD),timePostedRange:List({window}),distance:List({distance})),spellCorrectionEnabled:true)&servedEventEnabled=false&start={start}",
    "posting_url": "https://www.linkedin.com/voyager/api/jobs/jobPostings/{job_id}?decorationId=com.linkedin.voyager.deco.jobs.web.shared.WebFullJobPosting-65",
    "page_size": 25,
    "window": "r3600"
  }
}
